+static gboolean
+enhanced_codec_is_supported (const gchar * codec)
+{
+  return g_strcmp0 (codec, "ac-3") == 0 ||
+      g_strcmp0 (codec, "av01") == 0 ||
+      g_strcmp0 (codec, "avc1") == 0 ||
+      g_strcmp0 (codec, "ec-3") == 0 ||
+      g_strcmp0 (codec, "fLaC") == 0 ||
+      g_strcmp0 (codec, "hvc1") == 0 ||
+      g_strcmp0 (codec, "vvc1") == 0 ||
+      g_strcmp0 (codec, ".mp3") == 0 ||
+      g_strcmp0 (codec, "mp4a") == 0 ||
+      g_strcmp0 (codec, "Opus") == 0 ||
+      g_strcmp0 (codec, "vp09") == 0;
+}
+
+static GstAmfNode *
+enhanced_codecs_to_fourcc_list (const gchar * codecs)
+{
+  GstAmfNode *list;
+  gchar **parts;
+  guint count = 0;
+
+  if (!codecs || !*codecs)
+    return NULL;
+
+  list = gst_amf_node_new_strict_array ();
+  parts = g_strsplit (codecs, ",", -1);
+
+  for (guint i = 0; parts && parts[i]; i++) {
+    gchar *codec = g_strstrip (parts[i]);
+
+    if (strlen (codec) != 4 || !enhanced_codec_is_supported (codec)) {
+      GST_WARNING ("Skipping unsupported Enhanced RTMP codec FourCC '%s'",
+          codec);
+      continue;
+    }
+
+    gst_amf_node_append_take_element (list,
+        gst_amf_node_new_string (codec, 4));
+    count++;
+  }
+
+  g_strfreev (parts);
+
+  if (count == 0) {
+    gst_amf_node_free (list);
+    return NULL;
+  }
+
+  return list;
+}
